# Copy names into Vercel → Project → Settings → Environment Variables.
# Never commit real values. Locally: cp .env.example .env.local

# --- Required ---
ANTHROPIC_API_KEY=

# --- Recommended: shared passcode for the preview URL (empty = open to anyone) ---
APP_PASSCODE=

# --- Native reviewer page (/review). Separate passcode; the page is off until this is set ---
REVIEWER_PASSCODE=

# --- STT providers: set any subset; unset ones show "not configured" ---
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# --- Storage: Vercel Blob (PRIVATE store) for the TTS audio cache and saved Say-it cards ---
# Added automatically when you connect a Blob store to the project in Vercel → Storage.
BLOB_READ_WRITE_TOKEN=

# --- TTS: Azure voices use AZURE_SPEECH_KEY/REGION above. ElevenLabs voices are listed here ---
# Label=voiceId pairs from the ElevenLabs Voice Library (add the voices to your account first).
ELEVENLABS_TTS_VOICES=

# Dev/test only, never on Vercel: store blobs as files in this folder instead of Vercel Blob.
# KALAM_LOCAL_BLOB_DIR=

# --- Optional overrides ---
# ANTHROPIC_MODEL=claude-opus-5-5
# ELEVENLABS_STT_MODEL=scribe_v1
# AZURE_SPEECH_LOCALES=ar-JO,ar-LB,ar-SY
# AZURE_TTS_VOICES=ar-JO-SanaNeural,ar-JO-TaimNeural,ar-LB-LaylaNeural,ar-LB-RamiNeural,ar-SY-AmanyNeural,ar-SY-LaithNeural
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
